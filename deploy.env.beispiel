# Vorlage für tools/deploy.sh. Kopieren nach deploy.env (wird von Git ignoriert) und anpassen.
# Keine Passwörter eintragen: Anmeldung per SSH-Schlüssel.

# Ziel auf dem Server: benutzer@server:/pfad/zum/webroot
DEPLOY_ZIEL="benutzer@server.example:/var/www/feedback-tools"

# rsync (Standard, löscht auf dem Server, was nicht mehr in dist/ ist) oder sftp (nur hochladen)
DEPLOY_METHODE="rsync"

# SSH-Port (Standard 22)
DEPLOY_PORT="22"

# Optional: Pfad zum privaten SSH-Schlüssel, sonst nimmt ssh den Standardschlüssel
# DEPLOY_SCHLUESSEL="$HOME/.ssh/id_ed25519"
